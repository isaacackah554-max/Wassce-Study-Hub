/* =========================
   DATA
========================= */

let userData = JSON.parse(localStorage.getItem("wassceHubData")) || {
  name: "Student",
  school: "",
  className: "",
  streak: 0,
  progress: 0,
  score: 0,
  goalDone: false,
  lastStudyDate: ""
};

function saveData() {
  localStorage.setItem("wassceHubData", JSON.stringify(userData));
}


/* =========================
   NAVIGATION
========================= */

function showSection(id) {
  document.querySelectorAll(".section").forEach(section => {
    section.classList.remove("active");
  });

  document.getElementById(id).classList.add("active");
  window.scrollTo({top: 0, behavior: "smooth"});
}


/* =========================
   DARK MODE
========================= */

if(localStorage.getItem("darkMode") === "true") {
  document.body.classList.add("dark");
}

function toggleDark() {
  document.body.classList.toggle("dark");

  localStorage.setItem(
    "darkMode",
    document.body.classList.contains("dark")
  );
}


/* =========================
   PROFILE
========================= */

function saveProfile() {
  const name = document.getElementById("nameInput").value.trim();

  if(name) userData.name = name;

  userData.className =
    document.getElementById("classInput").value;

  userData.school =
    document.getElementById("schoolInput").value;

  saveData();
  updateUI();

  document.getElementById("profileMessage").innerHTML =
    "✅ Profile saved successfully!";
}

function loadProfile() {
  document.getElementById("nameInput").value = userData.name;
  document.getElementById("classInput").value = userData.className;
  document.getElementById("schoolInput").value = userData.school;
}


/* =========================
   STREAK
========================= */

function studyToday() {
  const today = new Date().toDateString();

  if(userData.lastStudyDate === today) {
    alert("You already recorded your study for today! 🔥");
    return;
  }

  userData.streak++;
  userData.lastStudyDate = today;

  saveData();
  updateUI();

  alert("Great work! Your streak is now " + userData.streak + " days! 🔥");
}


/* =========================
   GOAL
========================= */

function completeGoal() {
  userData.goalDone = true;
  saveData();
  updateUI();

  alert("🎉 Daily goal completed! Keep going!");
}


/* =========================
   SUBJECTS
========================= */

const notes = {

"Core Mathematics": `
<h2>🧮 Core Mathematics</h2>
<div class="note-content">
<h3>Important Areas</h3>
<p>• Algebra and equations</p>
<p>• Geometry and mensuration</p>
<p>• Statistics and probability</p>
<p>• Sets and number systems</p>
<p><strong>Tip:</strong> Practice calculations regularly and always check your working.</p>
</div>`,

"Biology": `
<h2>🧬 Biology</h2>
<div class="note-content">
<h3>Important Areas</h3>
<p>• Cell structure and functions</p>
<p>• Nutrition and respiration</p>
<p>• Ecology and ecosystems</p>
<p>• Genetics and reproduction</p>
<p><strong>Tip:</strong> Learn diagrams and understand processes instead of memorizing everything.</p>
</div>`,

"Physics": `
<h2>⚡ Physics</h2>
<div class="note-content">
<h3>Important Areas</h3>
<p>• Motion and forces</p>
<p>• Energy and work</p>
<p>• Electricity</p>
<p>• Waves and sound</p>
<p><strong>Tip:</strong> Understand formulas and practice applying them to questions.</p>
</div>`,

"Chemistry": `
<h2>🧪 Chemistry</h2>
<div class="note-content">
<h3>Important Areas</h3>
<p>• Atomic structure</p>
<p>• Periodic table</p>
<p>• Acids, bases and salts</p>
<p>• Chemical bonding</p>
<p><strong>Tip:</strong> Learn chemical symbols, equations and practical observations.</p>
</div>`,

"English": `
<h2>📖 English Language</h2>
<div class="note-content">
<h3>Important Areas</h3>
<p>• Essay writing</p>
<p>• Grammar</p>
<p>• Comprehension</p>
<p>• Vocabulary</p>
<p><strong>Tip:</strong> Read often and practice writing clear sentences.</p>
</div>`,

"Social Studies": `
<h2>🌍 Social Studies</h2>
<div class="note-content">
<h3>Important Areas</h3>
<p>• Environment</p>
<p>• Development</p>
<p>• Governance</p>
<p>• Culture and society</p>
<p><strong>Tip:</strong> Use Ghanaian and real-life examples in your answers.</p>
</div>`,

"Add Mathematics": `
<h2>📐 Add Mathematics</h2>
<div class="note-content">
<h3>Important Areas</h3>
<p>• Algebra</p>
<p>• Trigonometry</p>
<p>• Calculus</p>
<p>• Coordinate geometry</p>
<p><strong>Tip:</strong> Solve many questions step by step.</p>
</div>`,

"ADF": `
<h2>🎨 ADF</h2>
<div class="note-content">
<h3>Important Areas</h3>
<p>• Elements of design</p>
<p>• Principles of design</p>
<p>• Drawing and composition</p>
<p>• Creative problem solving</p>
<p><strong>Tip:</strong> Practice regularly and develop your own creative ideas.</p>
</div>`

};

function openSubject(subject) {

  document.getElementById("subjectDetails").innerHTML = `
  <div class="card" style="margin-top:25px;">
    ${notes[subject]}
    <button class="btn" onclick="showSection('quiz')">
      📝 Practice Quiz
    </button>
  </div>`;

  window.scrollTo({
    top: document.getElementById("subjectDetails").offsetTop - 50,
    behavior: "smooth"
  });
}

function searchSubjects(text) {

  text = text.toLowerCase();

  document.querySelectorAll(".subject-card").forEach(card => {

    const name = card.dataset.name;

    card.style.display =
      name.includes(text) ? "block" : "none";

  });
}


/* =========================
   QUIZ
========================= */

const questions = [

{
subject: "Core Mathematics",
question: "What is 7 × 8?",
options: ["54", "56", "64", "48"],
answer: 1
},

{
subject: "Biology",
question: "What is the basic unit of life?",
options: ["Tissue", "Cell", "Organ", "System"],
answer: 1
},

{
subject: "Physics",
question: "What is the SI unit of force?",
options: ["Joule", "Newton", "Watt", "Volt"],
answer: 1
},

{
subject: "Chemistry",
question: "What is the chemical symbol for Oxygen?",
options: ["Ox", "O", "Og", "On"],
answer: 1
},

{
subject: "English",
question: "Choose the correct word: She ___ to school every day.",
options: ["go", "goes", "going", "gone"],
answer: 1
},

{
subject: "Social Studies",
question: "Which is an important agent of socialization?",
options: ["Family", "Rock", "Cloud", "Road"],
answer: 0
},

{
subject: "Add Mathematics",
question: "What is the derivative of x²?",
options: ["x", "2x", "x²", "2"]
