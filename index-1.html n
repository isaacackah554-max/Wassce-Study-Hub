<!DOCTYPE html><html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>WASSCE Study Hub | Learn. Practice. Succeed.</title><style>
:root {
  --primary: #4f46e5;
  --secondary: #7c3aed;
  --success: #16a34a;
  --warning: #f59e0b;
  --danger: #dc2626;
  --bg: #f4f7fb;
  --card: #ffffff;
  --text: #1e293b;
  --muted: #64748b;
  --border: #e2e8f0;
}

body.dark {
  --bg: #0f172a;
  --card: #1e293b;
  --text: #f8fafc;
  --muted: #cbd5e1;
  --border: #334155;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: Arial, sans-serif;
}

body {
  background: var(--bg);
  color: var(--text);
  transition: .3s;
}

button, input {
  font: inherit;
}

button {
  cursor: pointer;
}

header {
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: white;
  padding: 18px 5%;
  position: sticky;
  top: 0;
  z-index: 10;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  max-width: 1200px;
  margin: auto;
}

.logo {
  font-size: 22px;
  font-weight: bold;
}

.user-name {
  font-size: 14px;
  opacity: .9;
}

nav {
  max-width: 1200px;
  margin: 15px auto 0;
  display: flex;
  gap: 8px;
  overflow-x: auto;
}

nav button {
  border: none;
  background: rgba(255,255,255,.18);
  color: white;
  padding: 10px 14px;
  border-radius: 10px;
  white-space: nowrap;
}

nav button:hover {
  background: white;
  color: var(--primary);
}

.container {
  max-width: 1200px;
  margin: auto;
  padding: 25px 5%;
}

.section {
  display: none;
  animation: fade .3s;
}

.section.active {
  display: block;
}

@keyframes fade {
  from {opacity: 0; transform: translateY(8px);}
  to {opacity: 1; transform: translateY(0);}
}

.hero {
  background: linear-gradient(135deg, #312e81, #7c3aed);
  color: white;
  padding: 35px;
  border-radius: 20px;
  margin-bottom: 25px;
}

.hero h1 {
  font-size: clamp(28px, 5vw, 42px);
  margin-bottom: 10px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  gap: 18px;
}

.card {
  background: var(--card);
  border: 1px solid var(--border);
  padding: 20px;
  border-radius: 16px;
  box-shadow: 0 5px 15px rgba(0,0,0,.05);
}

.card h3 {
  margin-bottom: 10px;
}

.stat {
  font-size: 28px;
  font-weight: bold;
  color: var(--primary);
}

.btn {
  border: none;
  padding: 12px 18px;
  border-radius: 10px;
  background: var(--primary);
  color: white;
  margin-top: 12px;
}

.btn:hover {
  opacity: .9;
}

.btn.green {
  background: var(--success);
}

.btn.warning {
  background: var(--warning);
}

.subject-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 20px;
  transition: .2s;
}

.subject-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 25px rgba(0,0,0,.1);
}

.subject-icon {
  font-size: 35px;
  margin-bottom: 10px;
}

.progress-box {
  margin: 12px 0;
}

.progress-bg {
  height: 12px;
  background: #dbeafe;
  border-radius: 10px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  width: 0%;
  background: linear-gradient(90deg, var(--primary), #8b5cf6);
  transition: width .4s;
}

.timer-display {
  font-size: clamp(50px, 12vw, 90px);
  font-weight: bold;
  text-align: center;
  padding: 30px;
}

.center {
  text-align: center;
}

.quiz-option {
  width: 100%;
  text-align: left;
  padding: 15px;
  margin-top: 10px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: var(--card);
  color: var(--text);
}

.quiz-option:hover {
  border-color: var(--primary);
}

.quiz-option.correct {
  background: #dcfce7;
  color: #166534;
}

.quiz-option.wrong {
  background: #fee2e2;
  color: #991b1b;
}

input {
  width: 100%;
  padding: 13px;
  border: 1px solid var(--border);
  border-radius: 10px;
  margin: 8px 0;
  background: var(--card);
  color: var(--text);
}

.badge {
  display: inline-block;
  padding: 10px 14px;
  margin: 5px;
  border-radius: 20px;
  background: #fef3c7;
  color: #92400e;
}

.table-row {
  background: var(--card);
  border: 1px solid var(--border);
  padding: 15px;
  border-radius: 12px;
  margin: 10px 0;
}

.search {
  margin-bottom: 20px;
}

.note-content {
  line-height: 1.8;
  margin-top: 15px;
}

.login-box {
  max-width: 450px;
  margin: 50px auto;
}

.hidden {
  display: none;
}

footer {
  margin-top: 40px;
  padding: 25px;
  text-align: center;
  background: #111827;
  color: white;
}

@media(max-width: 600px) {
  header {
    padding: 15px;
  }

  .container {
    padding: 20px 15px;
  }

  .hero {
    padding: 25px 20px;
  }
}
</style></head><body><header>
