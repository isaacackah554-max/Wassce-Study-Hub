<div class="progress-fill" id="progressBar"></div>
</div><h2 style="margin-top:12px;"><span id="progressPercent">0</span>% Complete</h2><button class="btn" onclick="addProgress(5)">+ Add 5% Study</button>
<button class="btn green" onclick="addProgress(10)">+ Add 10% Study</button>

</div><div class="card" style="margin-top:20px;">
